{
  "dashboard": {
    "id": 2005511219093504,
    "uid": "devops-task-manager",
    "title": "DevOps Task Manager - System Metrics",
    "tags": ["devops", "kubernetes", "task-manager"],
    "timezone": "browser",
    "refresh": "5s",
    "schemaVersion": 16,
    "version": 3,
    "panels": [
      {
        "id": 1,
        "title": "Active Pod Replicas (K8s)",
        "type": "stat",
        "gridPos": { "h": 6, "w": 5, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "kube_deployment_status_replicas_available{deployment='devops-task-manager'}",
            "refId": "A",
            "legendFormat": "Active Pods"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "orange", "value": 1 },
                { "color": "green", "value": 2 }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Pod Status (1 = UP)",
        "type": "stat",
        "gridPos": { "h": 6, "w": 4, "x": 5, "y": 0 },
        "targets": [
          {
            "expr": "max(up{job='devops-task-manager'})",
            "refId": "A",
            "legendFormat": "Cluster Status"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Total HTTP Requests",
        "type": "stat",
        "gridPos": { "h": 6, "w": 5, "x": 9, "y": 0 },
        "targets": [
          {
            "expr": "max(app_http_requests_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" }
          }
        }
      },
      {
        "id": 4,
        "title": "Heap Memory Usage (MB)",
        "type": "stat",
        "gridPos": { "h": 6, "w": 5, "x": 14, "y": 0 },
        "targets": [
          {
            "expr": "round(max(app_memory_heap_used_bytes) / 1024 / 1024, 0.1)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" }
          }
        }
      },
      {
        "id": 5,
        "title": "App Uptime (Seconds)",
        "type": "stat",
        "gridPos": { "h": 6, "w": 5, "x": 19, "y": 0 },
        "targets": [
          {
            "expr": "max(app_uptime_seconds)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" }
          }
        }
      },
      {
        "id": 6,
        "title": "Kubernetes Dynamic Pod Scaling (Replicas)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
        "targets": [
          {
            "expr": "kube_deployment_status_replicas_available{deployment='devops-task-manager'}",
            "refId": "A",
            "legendFormat": "Available Pods"
          },
          {
            "expr": "kube_deployment_spec_replicas{deployment='devops-task-manager'}",
            "refId": "B",
            "legendFormat": "Desired Replicas"
          },
          {
            "expr": "kube_pod_status_phase{deployment='devops-task-manager',phase='Terminating'}",
            "refId": "C",
            "legendFormat": "Terminating Pods"
          }
        ]
      },
      {
        "id": 7,
        "title": "Live HTTP Traffic (Requests/sec)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
        "targets": [
          {
            "expr": "max(rate(app_http_requests_total[1m]))",
            "refId": "A",
            "legendFormat": "Req/sec"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
